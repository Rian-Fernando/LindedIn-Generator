NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Feedex feedback widget. Publishable key from the Feedex dashboard
# (Projects -> your project -> Install). Starts with pk_fdx_ and is safe in
# client HTML: it can only create feedback for its own project and is locked to
# the domain configured on that project. Leave blank to disable the widget.
NEXT_PUBLIC_FEEDEX_KEY=
